# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase ---
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — server-side only, bypasses RLS. Used by
# /api/intake and nowhere in client code.
SUPABASE_SECRET_KEY=

# --- Auth allowlist ---
# Comma-separated list of emails allowed to log in.
ALLOWED_EMAILS=

# --- Intake (Make.com -> POST /api/intake) ---
# Shared secret Make.com must send as the x-intake-secret header.
INTAKE_SECRET=

# --- MainWP ---
# Single API key from the MainWP dashboard used to post to all six
# station sites (Phase 2+).
MAINWP_API_KEY=
MAINWP_DASHBOARD_URL=

# --- Make.com Facebook webhooks (Phase 2+) ---
# One webhook URL per station; env var names must match
# src/config/stations.ts makeWebhookEnvVar values.
MAKE_WEBHOOK_MOO_92=
MAKE_WEBHOOK_MAGIC_97_7=
MAKE_WEBHOOK_NOTCH_FM=
MAKE_WEBHOOK_STATION_4=
MAKE_WEBHOOK_STATION_5=
MAKE_WEBHOOK_STATION_6=
