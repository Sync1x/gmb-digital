# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets. On Vercel, add the
# same variables under Project → Settings → Environment Variables.

# --- Supabase (required) ---
# Supabase dashboard → Project Settings → API.
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key. SERVER ONLY — bypasses RLS. Used by
# /api/intake and to upload images to Storage. Never expose it.
SUPABASE_SECRET_KEY=

# --- Login allowlist (required) ---
# Comma-separated emails allowed to use the app. Anyone else who signs in
# is signed straight back out. Accounts are created in Supabase → Auth → Users.
ALLOWED_EMAILS=

# --- Intake from Make.com (required) ---
# Shared secret Make.com sends in the x-intake-secret header when it POSTs
# drafts to /api/intake. Generate with: openssl rand -hex 32
INTAKE_SECRET=

# --- MainWP (required to publish) ---
# Root URL of the MainWP dashboard site, no trailing slash,
# e.g. https://manage.example.com
MAINWP_URL=
# REST API v2 key: MainWP → API Access → API Keys → Add API Keys.
# Needs Sites (read) and Posts (read + write). Shown only once when created.
MAINWP_API_KEY=

# --- Publish safety ---
# "draft" (default): posts are created as WordPress DRAFTS and Facebook
#   webhooks are NOT called. A yellow "Draft mode" badge shows in the header.
# "live": posts go public and each station's Facebook webhook fires.
PUBLISH_MODE=draft
# Optional, draft mode only: send EVERY station's post to this one MainWP
# site ID (see /settings) instead of the real station sites. Use while
# testing. Ignored when PUBLISH_MODE=live.
MAINWP_TEST_SITE_ID=

# --- Make.com Facebook webhooks (required for live mode) ---
# One Make "Custom webhook" URL per station. Names must match
# makeWebhookEnvVar in src/config/stations.ts. The app POSTs
# { post_id, post_url, title, station, station_name } only after WordPress
# has confirmed the post for that station.
MAKE_WEBHOOK_MOO_92=
MAKE_WEBHOOK_MAGIC_97_7=
MAKE_WEBHOOK_NOTCH_FM=
MAKE_WEBHOOK_JJ_COUNTRY=
MAKE_WEBHOOK_KIX_105_5=
MAKE_WEBHOOK_WSTJ_1340=

# --- Image search (optional but recommended) ---
# Brave Search API key (https://api-dashboard.search.brave.com), used for
# "Find image". Without it, staff can still upload/paste images.
BRAVE_SEARCH_API_KEY=

# --- AI title suggestions (optional) ---
# Set AI_ENABLED=true AND a DeepSeek key to show the "Suggest title" button.
# Anything else hides it; the app works fully without AI.
AI_ENABLED=false
# https://platform.deepseek.com → API keys.
DEEPSEEK_API_KEY=
# Optional model override (default: deepseek-chat).
DEEPSEEK_MODEL=
